# Copy to .streamlit/secrets.toml for local use, or paste into Streamlit Cloud > App settings > Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore).

GEMINI_API_KEY = "paste-your-key-from-aistudio.google.com"

# Optional overrides (defaults shown):
# GEMMA_MODEL = "gemma-4-26b-a4b-it"      # or "gemma-4-31b-it"
# EMBED_MODEL = "gemini-embedding-001"

# Optional: persistent database (Neon / Supabase Postgres). Leave unset to use SQLite.
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: local Ollama instead of the Gemini API
# LLM_BACKEND = "ollama"
# OLLAMA_URL = "http://localhost:11434"
# OLLAMA_MODEL = "gemma4"
# OLLAMA_EMBED_MODEL = "nomic-embed-text"
# TRANSCRIBE_MODEL = "gemini-2.5-flash"   # audio-capable model used for voice answers in the Interview Mock Bot
# FALLBACK_MODEL = "gemma-4-31b-it"        # tried automatically if the main model keeps returning errors
